# The variables this project reads. None is required: the defaults keep every path inside the
# repository and serve the checkpoint that is committed.
#
# Nothing here loads a `.env` file by itself. Copy this one, fill in what you need, and pass it
# to the command:
#
#     uv run --env-file .env uvicorn rl_lander.api:app
#
# A repository that read `.env` on import would apply a file the reader cannot see from the
# command they typed.

# --- Which policy the API and the GUI serve ---
# Default: models/ppo/best.zip inside the repository
RL_LANDER_MODEL_PATH=

# Which algorithm loads it. `ppo` or `dqn`; the two save different objects, and loading a
# checkpoint with the wrong class fails with a message about tensor shapes rather than about
# the algorithm.
# Default: ppo
RL_LANDER_ALGO=

# --- Where the Streamlit GUI looks for the API ---
# Default: http://127.0.0.1:8000
RL_LANDER_API_URL=

# --- Reproducibility ---
# Python reads this once, at interpreter start, so `set_global_seed` cannot install it for the
# process it runs in: it can only pass it on to subprocesses. Set it here when a result has to
# be identical across machines, and `rl_lander.utils.seeding` explains what it covers.
# Default: unset, and the first seeded call says so once
PYTHONHASHSEED=

# --- Taking the screenshots ---
# The browser scripts/capture.py drives, when it is not on PATH. A path hard-coded in the
# script would be one machine's installation shipped inside a published repository.
CHROME_PATH=
