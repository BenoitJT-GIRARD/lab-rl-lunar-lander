# Copy this file to `.env`, then fill in what you need. Nothing here is required: the
# defaults keep every path inside the repository.

# --- Where the artefacts are written ---
# Models, evaluation exports, TensorBoard logs and videos all hang off this directory.
# It is found by walking up from the package to the pyproject.toml, which is right for a
# checkout and wrong for an installed wheel -- set it explicitly in that case.
# Default: the repository root
ASTRODYNAMICS_ROOT=

# --- Which policy the API and the GUI serve ---
# Default: <ASTRODYNAMICS_ROOT>/models/ppo/best.zip
ASTRODYNAMICS_MODEL_PATH=

# --- Where the Streamlit GUI looks for the API ---
# Default: http://127.0.0.1:8000
ASTRODYNAMICS_API_URL=
